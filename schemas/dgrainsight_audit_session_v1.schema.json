{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgrainsight.local/schemas/dgrainsight_audit_session_v1.schema.json",
  "title": "DGraInsight Audit Session v1",
  "description": "Portable, offline-generated DGraInsight audit evidence for validated official model adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session",
    "model",
    "dataset",
    "checkpoint",
    "audit_plan",
    "samples",
    "relations",
    "evidence_records",
    "evidence_summary",
    "cross_run_evidence",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "dgrainsight.audit_session.v1"},
    "session": {"$ref": "#/$defs/sessionMetadata"},
    "model": {"$ref": "#/$defs/modelMetadata"},
    "dataset": {"$ref": "#/$defs/datasetMetadata"},
    "checkpoint": {"$ref": "#/$defs/checkpointMetadata"},
    "audit_plan": {"$ref": "#/$defs/auditPlan"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sampleRecord"}
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/relationRecord"}
    },
    "evidence_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRecord"}
    },
    "evidence_summary": {"$ref": "#/$defs/evidenceSummary"},
    "cross_run_evidence": {"$ref": "#/$defs/nullableEvidence"},
    "provenance": {"$ref": "#/$defs/runProvenance"},
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "model_specific": {
      "type": "object",
      "description": "Namespaced lossless fields not promoted into the common v1 contract.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sessionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "created_at", "generator", "source_mode"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "run_id"],
          "properties": {
            "name": {"const": "DGraInsight offline audit pipeline"},
            "version": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1}
          }
        },
        "source_mode": {"const": "offline_audit"},
        "title": {"type": ["string", "null"]}
      }
    },
    "modelMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "adapter", "adapter_id", "native_context_type", "configuration"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "native_context_type": {"type": "string", "minLength": 1},
        "source_repository": {"type": ["string", "null"]},
        "source_commit": {"type": ["string", "null"]},
        "configuration": {"type": "object", "additionalProperties": true}
      },
      "allOf": [
        {
          "if": {"properties": {"name": {"const": "DGraFormer"}}},
          "then": {
            "properties": {
              "adapter": {"const": "DGraFormerAdapter"},
              "adapter_id": {"const": "dgraformer"},
              "native_context_type": {"const": "window"}
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "MSGNet"}}},
          "then": {
            "properties": {
              "adapter": {"const": "MSGNetAdapter"},
              "adapter_id": {"const": "msgnet"},
              "native_context_type": {"const": "scale"}
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "MTGNN"}}},
          "then": {
            "properties": {
              "adapter": {"const": "MTGNNAdapter"},
              "adapter_id": {"const": "mtgnn"},
              "native_context_type": {"const": "global_graph"}
            }
          }
        }
      ]
    },
    "datasetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "format", "sha256", "variables", "date_column", "features",
        "target", "frequency", "seq_len", "label_len", "pred_len"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "date_column": {"type": "string", "minLength": 1},
        "features": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "frequency": {"type": "string", "minLength": 1},
        "seq_len": {"type": "integer", "minimum": 1},
        "label_len": {"type": "integer", "minimum": 1},
        "pred_len": {"type": "integer", "minimum": 1},
        "original_path": {"type": ["string", "null"]}
      }
    },
    "checkpointMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "format", "load_status"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"type": "string", "minLength": 1},
        "load_status": {"const": "validated"},
        "original_path": {"type": ["string", "null"]}
      }
    },
    "auditPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "sample_indices", "relation_count", "local_scope", "broader_context_scope"],
      "properties": {
        "split": {"const": "test"},
        "sample_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "relation_count": {"type": "integer", "minimum": 1},
        "local_scope": {"const": "exact_native_context"},
        "broader_context_scope": {"enum": ["not_requested", "all_applicable_native_contexts"]},
        "candidate_protocol": {"type": ["string", "null"]},
        "control_protocol": {"type": ["string", "null"]},
        "multiple_comparison_protocol": {"type": ["string", "null"]}
      }
    },
    "nestedValue": {
      "oneOf": [
        {"type": ["number", "integer", "boolean"]},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/nestedValue"}
        }
      ]
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "axis_order", "values"],
      "properties": {
        "dtype": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "axis_order": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/nestedValue"}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableTensor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "reason"],
          "properties": {
            "status": {"const": "available"},
            "value": {"$ref": "#/$defs/tensor"},
            "reason": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "reason"],
          "properties": {
            "status": {"enum": ["missing", "unavailable"]},
            "value": {"type": "null"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "metricValue": {
      "oneOf": [
        {"type": ["number", "integer", "null"]},
        {
          "type": "array",
          "items": {"type": ["number", "integer"]}
        }
      ]
    },
    "metricMap": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/metricValue"}
    },
    "metricStatus": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "reason"],
        "properties": {
          "status": {"enum": ["available", "missing", "undefined", "not_applicable"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "graphContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "type", "index", "node_count", "graphs", "native_metadata"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "layer": {"type": "integer", "minimum": 0},
        "node_count": {"type": "integer", "minimum": 1},
        "graphs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/tensor"}
        },
        "native_metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "scale"}}},
          "then": {"required": ["layer"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["window", "global_graph"]}}},
          "then": {"not": {"required": ["layer"]}}
        }
      ]
    },
    "sampleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id", "display_id", "split", "sample_index", "history", "ground_truth",
        "baseline_prediction", "sample_metrics", "contexts", "provenance"
      ],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "display_id": {"type": ["integer", "null"], "minimum": 0},
        "split": {"const": "test"},
        "sample_index": {"type": "integer", "minimum": 0},
        "history": {"$ref": "#/$defs/nullableTensor"},
        "ground_truth": {"$ref": "#/$defs/tensor"},
        "baseline_prediction": {"$ref": "#/$defs/tensor"},
        "sample_metrics": {"$ref": "#/$defs/metricMap"},
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/graphContext"}
        },
        "provenance": {"type": "object", "additionalProperties": true},
        "model_specific": {"type": "object", "additionalProperties": true}
      }
    },
    "relationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id", "sample_id", "source", "target", "source_name", "target_name",
        "native_occurrences", "evidence_ids"
      ],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "sample_id": {"type": "string", "minLength": 1},
        "source": {"type": "integer", "minimum": 0},
        "target": {"type": "integer", "minimum": 0},
        "source_name": {"type": "string", "minLength": 1},
        "target_name": {"type": "string", "minLength": 1},
        "native_occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context_id", "weight", "retained"],
            "properties": {
              "context_id": {"type": "string", "minLength": 1},
              "weight": {"type": "number"},
              "retained": {"type": "boolean"},
              "rank": {"type": ["integer", "number", "null"]}
            }
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "model_specific": {"type": "object", "additionalProperties": true}
      }
    },
    "exactSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model", "dataset", "sample_id", "sample_index", "context_type", "context_id",
        "context_index", "source", "target", "source_name", "target_name", "scope"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "sample_id": {"type": "string", "minLength": 1},
        "sample_index": {"type": "integer", "minimum": 0},
        "context_type": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1},
        "context_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"enum": ["all_applicable"]}
          ]
        },
        "layer": {"type": ["integer", "null"], "minimum": 0},
        "source": {"type": "integer", "minimum": 0},
        "target": {"type": "integer", "minimum": 0},
        "source_name": {"type": "string", "minLength": 1},
        "target_name": {"type": "string", "minLength": 1},
        "scope": {"enum": ["local", "broader_context"]}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "local"}}},
          "then": {
            "properties": {
              "context_type": {"type": "string", "minLength": 1},
              "context_index": {"type": "integer", "minimum": 0}
            }
          }
        },
        {
          "if": {"properties": {"scope": {"const": "broader_context"}}},
          "then": {
            "properties": {
              "context_type": {"type": "string", "minLength": 1},
              "context_index": {"const": "all_applicable"}
            }
          }
        },
        {
          "if": {"properties": {"context_type": {"enum": ["scale", "scale_set"]}}},
          "then": {"required": ["layer"]}
        },
        {
          "if": {"properties": {"context_type": {"enum": ["window", "global_graph", "window_set"]}}},
          "then": {"not": {"required": ["layer"]}}
        }
      ]
    },
    "controlEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "protocol", "count", "random_seed", "values", "records", "summary"],
      "properties": {
        "status": {"enum": ["available", "missing", "not_applicable"]},
        "protocol": {"type": ["string", "null"]},
        "count": {"type": ["integer", "null"], "minimum": 0},
        "random_seed": {"type": ["integer", "null"]},
        "values": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value", "reason"],
              "properties": {
                "status": {"const": "available"},
                "value": {
                  "type": "array",
                  "items": {"type": "number"}
                },
                "reason": {"type": "null"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value", "reason"],
              "properties": {
                "status": {"enum": ["missing", "not_applicable"]},
                "value": {"type": "null"},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "records": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "summary": {"$ref": "#/$defs/metricMap"},
        "records_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "model_specific": {"type": "object", "additionalProperties": true}
      }
    },
    "evidencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_output_ref", "intervention_output", "metrics", "statistics", "metric_status",
        "controls", "graph_effect", "diagnostic_localization", "limitations", "provenance"
      ],
      "properties": {
        "baseline_output_ref": {"type": "string", "minLength": 1},
        "intervention_output": {"$ref": "#/$defs/nullableTensor"},
        "metrics": {"$ref": "#/$defs/metricMap"},
        "statistics": {"$ref": "#/$defs/metricMap"},
        "metric_status": {"$ref": "#/$defs/metricStatus"},
        "controls": {"$ref": "#/$defs/controlEvidence"},
        "graph_effect": {"type": "object", "additionalProperties": true},
        "diagnostic_localization": {"type": ["object", "null"], "additionalProperties": true},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "object", "additionalProperties": true},
        "model_specific": {"type": "object", "additionalProperties": true}
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "relation_id", "selection", "status", "reason", "value"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "relation_id": {"type": "string", "minLength": 1},
        "selection": {"$ref": "#/$defs/exactSelection"},
        "status": {"enum": ["available", "not_exposed", "missing", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/evidencePayload"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["missing", "unavailable"]}}},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["available", "not_exposed"]}}},
          "then": {
            "properties": {
              "value": {"$ref": "#/$defs/evidencePayload"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {"properties": {"reason": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "not_exposed"}}},
          "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "evidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_case_count", "broader_context_case_count", "local_bh_supported_count",
        "broader_context_bh_supported_count", "negative_evidence_preserved"
      ],
      "properties": {
        "local_case_count": {"type": "integer", "minimum": 0},
        "broader_context_case_count": {"type": "integer", "minimum": 0},
        "local_bh_supported_count": {"type": ["integer", "null"], "minimum": 0},
        "broader_context_bh_supported_count": {"type": ["integer", "null"], "minimum": 0},
        "negative_evidence_preserved": {"const": true},
        "not_exposed_case_count": {"type": "integer", "minimum": 0},
        "missing_case_count": {"type": "integer", "minimum": 0}
      }
    },
    "nullableEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "reason"],
          "properties": {
            "status": {"const": "available"},
            "value": {"type": "object", "additionalProperties": true},
            "reason": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "reason"],
          "properties": {
            "status": {"enum": ["missing", "not_evaluated", "unavailable"]},
            "value": {"type": "null"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "sourceRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "run_id", "artifact_status"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "artifact_status": {"enum": ["available", "referenced_not_present", "missing"]},
        "manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "artifact_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "runProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_generation_run_id", "validation", "config_sha256",
        "source_runs", "commands", "environment", "code_references", "source_artifacts"
      ],
      "properties": {
        "session_generation_run_id": {"type": "string", "minLength": 1},
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status", "report_sha256"],
          "properties": {
            "kind": {"enum": ["adapter_preflight", "artifact_roundtrip_validation"]},
            "status": {"const": "passed"},
            "report_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceRun"}
        },
        "commands": {"type": "array", "items": {"type": "string"}},
        "environment": {"type": "object", "additionalProperties": true},
        "code_references": {"type": "array", "items": {"type": "string"}},
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "sha256", "status"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "path": {"type": ["string", "null"]},
              "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "status": {"enum": ["available", "missing", "referenced_not_present"]}
            }
          }
        }
      }
    }
  }
}
